<Window x:Class="MultiTeam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MultiTeam"
        mc:Ignorable="d"
        Title="MultiTeam Hub" 
        Height="820" Width="1340"
        MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0f172a"
        Foreground="#f8fafc"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4f46e5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4338ca"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TopBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="#cbd5e1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="#ffffff"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlatformChipStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#0f172a"/>
            <Setter Property="Foreground" Value="#cbd5e1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#64748b"/>
                    <Setter Property="Background" Value="#161f30"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="BorderBrush" Value="#4f46e5"/>
                    <Setter Property="Background" Value="#312e81"/>
                    <Setter Property="Foreground" Value="#ffffff"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GroupSuggestionChipStyle" TargetType="Button">
            <Setter Property="Background" Value="#161f30"/>
            <Setter Property="Foreground" Value="#cbd5e1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- MAIN WORKSPACE SPLIT (Sidebar + Content) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="300" MinWidth="68" MaxWidth="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" 
                    Background="#0b0f19" 
                    BorderBrush="#1e293b" 
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand Header & Sidebar Collapse Toggle -->
                    <Border Grid.Row="0" Padding="14,14" BorderBrush="#1e293b" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#4f46e5" Margin="0,0,10,0">
                                <TextBlock Text="MT" 
                                           FontWeight="Black" 
                                           FontSize="15" 
                                           Foreground="White" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel x:Name="BrandTextPanel" Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="MultiTeam Hub" FontWeight="Bold" FontSize="15" Foreground="#f8fafc"/>
                                <TextBlock x:Name="TxtBrandSubtitle" Text="Teams • Zalo • Tele • Messenger..." FontSize="10" Foreground="#64748b"/>
                            </StackPanel>

                            <Button Grid.Column="2" 
                                    x:Name="BtnToggleSidebar"
                                    Content="≡" 
                                    FontSize="17" 
                                    FontWeight="Bold" 
                                    Width="30" Height="30" 
                                    Background="Transparent" 
                                    Foreground="#94a3b8" 
                                    BorderThickness="0" 
                                    Cursor="Hand" 
                                    ToolTip="Thu nhỏ / Mở rộng Sidebar" 
                                    Click="BtnToggleSidebar_Click"/>
                        </Grid>
                    </Border>

                    <!-- Add Profile Button -->
                    <StackPanel Grid.Row="1" Margin="10,10,10,4">
                        <Button Style="{StaticResource SidebarButtonStyle}" 
                                Click="BtnOpenCreateModal_Click"
                                ToolTip="Tạo mới profile chat">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="＋ " FontWeight="Bold" FontSize="15" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TxtAddBtnLabel" Text="Thêm tài khoản mới" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Search Accounts Box (Hidden in mini mode) -->
                    <Border x:Name="SearchPanel" Grid.Row="2" Margin="10,4,10,6">
                        <Grid>
                            <TextBox x:Name="TxtSearchAccounts" 
                                     Background="#161f30" 
                                     Foreground="#f8fafc" 
                                     BorderBrush="#334155" 
                                     BorderThickness="1" 
                                     Padding="8,5" 
                                     FontSize="12" 
                                     CaretBrush="#f8fafc" 
                                     TextChanged="TxtSearchAccounts_TextChanged"/>
                            <TextBlock x:Name="TxtSearchPlaceholder" 
                                       Text="🔍 Tìm tài khoản (Ctrl+F)..." 
                                       Foreground="#64748b" 
                                       FontSize="12" 
                                       Margin="10,0,0,0" 
                                       VerticalAlignment="Center" 
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearchAccounts}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- GROUPED ACCOUNT LIST (Accordion/Expanders) -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,2">
                        <ItemsControl x:Name="GroupsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6">
                                        <StackPanel>
                                            <!-- Group Header (Hidden in mini sidebar) -->
                                            <Border x:Name="GroupHeaderBorder"
                                                    Background="#141c2e" 
                                                    CornerRadius="6" 
                                                    Padding="10,6" 
                                                    Margin="8,2" 
                                                    Cursor="Hand"
                                                    MouseLeftButtonDown="GroupHeader_MouseLeftButtonDown">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <!-- If sidebar is collapsed, hide group headers to keep avatars clean -->
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsSidebarCollapsed}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" 
                                                               Text="{Binding ArrowIcon}" 
                                                               FontSize="9" 
                                                               Foreground="#94a3b8" 
                                                               Margin="0,0,8,0" 
                                                               VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" 
                                                                   FontWeight="Bold" 
                                                                   FontSize="11.5" 
                                                                   Foreground="#cbd5e1"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding CountText}" 
                                                                   FontSize="10.5" 
                                                                   Foreground="#64748b" 
                                                                   Margin="6,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Group Total Unread Badge -->
                                                    <Border Grid.Column="2" 
                                                            Background="#ef4444" 
                                                            CornerRadius="10" 
                                                            Padding="6,1" 
                                                            Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding TotalUnreadCount}" 
                                                                   FontSize="10" 
                                                                   FontWeight="Bold" 
                                                                   Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Child Accounts under this group -->
                                            <ItemsControl ItemsSource="{Binding Accounts}" 
                                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- Account Item Card -->
                                                        <Border x:Name="ItemBorder"
                                                                Margin="8,2"
                                                                Padding="8,6"
                                                                CornerRadius="6"
                                                                Cursor="Hand"
                                                                ToolTip="{Binding Name}"
                                                                BorderThickness="3.5,0,0,0"
                                                                BorderBrush="{Binding DisplayTagColor}"
                                                                MouseLeftButtonDown="AccountItem_MouseLeftButtonDown">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Background" Value="#1e293b"/>
                                                                        </DataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsActive}" Value="False"/>
                                                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Background" Value="#161f30"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>

                                                            <!-- Right-Click Context Menu -->
                                                            <Border.ContextMenu>
                                                                <ContextMenu Background="#1e293b" Foreground="#f8fafc" BorderBrush="#334155">
                                                                    <MenuItem Header="{Binding PinStatusText}" Click="MenuItemTogglePin_Click"/>
                                                                    <MenuItem Header="{Binding MuteStatusText}" Click="MenuItemToggleMute_Click"/>
                                                                    <Separator Background="#334155"/>
                                                                    
                                                                    <!-- Change Tag Color Submenu -->
                                                                    <MenuItem Header="🎨 Đổi màu nhận diện (Tag Color)...">
                                                                        <MenuItem Header="🔴 Đỏ (Khẩn cấp / VIP)" Click="MenuItemSetColor_Click" Tag="#ef4444"/>
                                                                        <MenuItem Header="🟠 Cam (Bán hàng / Leads)" Click="MenuItemSetColor_Click" Tag="#f97316"/>
                                                                        <MenuItem Header="🟡 Vàng (Chăm sóc KH)" Click="MenuItemSetColor_Click" Tag="#eab308"/>
                                                                        <MenuItem Header="🟢 Xanh lục (Đã chốt)" Click="MenuItemSetColor_Click" Tag="#10b981"/>
                                                                        <MenuItem Header="🔵 Xanh dương (Khách lẻ)" Click="MenuItemSetColor_Click" Tag="#3b82f6"/>
                                                                        <MenuItem Header="🟣 Tím (Nội bộ Cty)" Click="MenuItemSetColor_Click" Tag="#8b5cf6"/>
                                                                        <MenuItem Header="🌸 Hồng (Cá nhân)" Click="MenuItemSetColor_Click" Tag="#ec4899"/>
                                                                        <MenuItem Header="⚪ Mặc định nền tảng" Click="MenuItemSetColor_Click" Tag=""/>
                                                                    </MenuItem>

                                                                    <!-- Move to Group Menu -->
                                                                    <MenuItem Header="📁 Chuyển vào nhóm..." Click="MenuItemMoveGroup_Click"/>

                                                                    <Separator Background="#334155"/>
                                                                    <MenuItem Header="💤 Cho vào chế độ ngủ đông (Giải phóng RAM)" Click="MenuItemHibernate_Click"/>
                                                                    <MenuItem Header="⚡ Đánh thức tài khoản" Click="MenuItemWakeup_Click"/>
                                                                    <Separator Background="#334155"/>

                                                                    <MenuItem Header="🧹 Xóa Cache &amp; Đăng xuất" Click="MenuItemClearCache_Click"/>
                                                                    <MenuItem Header="Đổi tên..." Click="MenuItemRename_Click"/>
                                                                    <MenuItem Header="Mở thư mục dữ liệu" Click="MenuItemOpenFolder_Click"/>
                                                                    <Separator Background="#334155"/>
                                                                    <MenuItem Header="Xóa tài khoản này" Click="MenuItemDelete_Click"/>
                                                                </ContextMenu>
                                                            </Border.ContextMenu>

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Platform & Initial Circle (Colored by TagColor) -->
                                                                <Grid Grid.Column="0" Margin="0,0,8,0">
                                                                    <Border Width="32" Height="32" 
                                                                            CornerRadius="16" 
                                                                            Background="{Binding DisplayTagColor}">
                                                                        <TextBlock Text="{Binding Initial}" 
                                                                                   Foreground="White" 
                                                                                   FontWeight="Bold" 
                                                                                   FontSize="12.5" 
                                                                                   HorizontalAlignment="Center" 
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <!-- Pinned Dot -->
                                                                    <Border Width="9" Height="9" 
                                                                            CornerRadius="4.5" 
                                                                            Background="#eab308" 
                                                                            HorizontalAlignment="Right" 
                                                                            VerticalAlignment="Top" 
                                                                            Margin="0,-2,-2,0" 
                                                                            Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" 
                                                                            ToolTip="Đã ghim lên đầu"/>
                                                                </Grid>

                                                                <!-- Account Info -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Name}" 
                                                                                   FontWeight="SemiBold" 
                                                                                   FontSize="12.5" 
                                                                                   Foreground="#f8fafc"
                                                                                   MaxWidth="130"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text=" 🔇" 
                                                                                   FontSize="10" 
                                                                                   Foreground="#94a3b8" 
                                                                                   Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}"/>
                                                                        <TextBlock Text="{Binding LifecycleBadge}" 
                                                                                   FontSize="9.5" 
                                                                                   ToolTip="{Binding LifecycleStatusText}" 
                                                                                   Margin="3,0,0,0" 
                                                                                   VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                        <Border Background="#1e293b" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                                                                            <TextBlock Text="{Binding PlatformDisplayName}" 
                                                                                       FontSize="8.5" 
                                                                                       FontWeight="Bold" 
                                                                                       Foreground="{Binding PlatformColor}"/>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Id}" 
                                                                                   FontSize="8.5" 
                                                                                   Foreground="#64748b" 
                                                                                   VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <!-- Unread Badge -->
                                                                <Border Grid.Column="2" 
                                                                        Background="#ef4444" 
                                                                        CornerRadius="10" 
                                                                        Padding="6,2" 
                                                                        Margin="2,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="{Binding UnreadCount}" 
                                                                               FontSize="10.5" 
                                                                               FontWeight="Bold" 
                                                                               Foreground="White"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Sidebar Footer -->
                    <Border Grid.Row="4" Padding="10" BorderBrush="#1e293b" BorderThickness="0,1,0,0">
                        <Button Style="{StaticResource TopBarButtonStyle}" 
                                HorizontalAlignment="Stretch"
                                ToolTip="Mở thư mục Sessions"
                                Click="BtnOpenSessionsFolder_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📁 "/>
                                <TextBlock x:Name="TxtFooterLabel" Text="Thư mục Sessions" Foreground="#94a3b8"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN CONTENT AREA -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Header Bar -->
                <Border Grid.Row="0" 
                    Background="#0f172a" 
                    BorderBrush="#1e293b" 
                    BorderThickness="0,0,0,1" 
                    Padding="14,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Navigation controls (Back, Forward, Active Account Title) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource TopBarButtonStyle}" 
                                    Content="◀" 
                                    ToolTip="Quay lại (Back)" 
                                    Click="BtnBack_Click" 
                                    Margin="0,0,3,0"/>
                            <Button Style="{StaticResource TopBarButtonStyle}" 
                                    Content="▶" 
                                    ToolTip="Tiến lên (Forward)" 
                                    Click="BtnForward_Click" 
                                    Margin="0,0,10,0"/>

                            <Ellipse x:Name="ActiveStatusDot" Width="8" Height="8" Fill="#10b981" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtActiveAccountName" 
                                       Text="Đang tải..." 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Foreground="#f8fafc"/>
                            <TextBlock x:Name="TxtStatus" 
                                       Text=" (Sẵn sàng)" 
                                       FontSize="12" 
                                       Foreground="#94a3b8" 
                                       Margin="6,0,0,0"/>
                        </StackPanel>

                        <!-- Top Action Buttons: Zoom, Memory Saver, Mute, Reload, Home, Language Toggle -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Zoom Controls -->
                            <Border Background="#161f30" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Margin="3,0" Padding="2,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="－" 
                                            Background="Transparent" 
                                            Foreground="#cbd5e1" 
                                            BorderThickness="0" 
                                            Padding="6,2" 
                                            Cursor="Hand" 
                                            ToolTip="Thu nhỏ (Ctrl -)" 
                                            Click="BtnZoomOut_Click"/>
                                    <TextBlock x:Name="TxtZoomLevel" 
                                               Text="100%" 
                                               FontSize="11" 
                                               Foreground="#94a3b8" 
                                               VerticalAlignment="Center" 
                                               Margin="4,0" 
                                               Cursor="Hand" 
                                               ToolTip="Click để đặt lại 100%" 
                                               MouseLeftButtonDown="TxtZoomLevel_MouseLeftButtonDown"/>
                                    <Button Content="＋" 
                                            Background="Transparent" 
                                            Foreground="#cbd5e1" 
                                            BorderThickness="0" 
                                            Padding="6,2" 
                                            Cursor="Hand" 
                                            ToolTip="Phóng to (Ctrl +)" 
                                            Click="BtnZoomIn_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Memory Monitor & Trim RAM Button -->
                            <Button x:Name="BtnTrimMemory" 
                                    Style="{StaticResource TopBarButtonStyle}" 
                                    ToolTip="Giải phóng RAM ngay (EmptyWorkingSet &amp; Trim WebView2)" 
                                    Click="BtnTrimMemory_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtMemoryUsage" Text="📊 RAM: -- MB" FontSize="11" FontWeight="SemiBold" Foreground="#38bdf8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtTrimMemoryLabel" Text="⚡ Dọn RAM" FontSize="12" FontWeight="SemiBold" Foreground="#f8fafc" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Memory Saver Toggle Button -->
                            <Button x:Name="BtnMemorySaver" 
                                    Style="{StaticResource TopBarButtonStyle}" 
                                    Content="⚡ Tiết kiệm RAM: Bật" 
                                    ToolTip="Tự động tạm dừng tài khoản nền để giải phóng RAM" 
                                    Click="BtnMemorySaver_Click"/>

                            <!-- Mute Toggle -->
                            <Button x:Name="BtnMuteToggle" 
                                    Style="{StaticResource TopBarButtonStyle}" 
                                    Content="🔔 Bật chuông" 
                                    ToolTip="Bật / Tắt âm báo cho tài khoản này" 
                                    Click="BtnMuteToggle_Click"/>

                            <!-- Reload & Home -->
                            <Button x:Name="BtnReload" 
                                    Style="{StaticResource TopBarButtonStyle}" 
                                    Content="🔄 Tải lại" 
                                    Click="BtnReload_Click"/>
                            <Button x:Name="BtnHome" 
                                    Style="{StaticResource TopBarButtonStyle}" 
                                    Content="🏠 Trang chủ" 
                                    Click="BtnHome_Click"/>

                            <!-- Language Switcher Button -->
                            <Button x:Name="BtnLanguageToggle" 
                                    Style="{StaticResource TopBarButtonStyle}" 
                                    Content="🇻🇳 Tiếng Việt" 
                                    ToolTip="Chuyển đổi ngôn ngữ / Switch Language" 
                                    Click="BtnLanguageToggle_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- WebView2 Dynamic Container Grid -->
                <Grid Grid.Row="1" x:Name="WebViewsContainer" Background="#020617">
                    <!-- Placeholder when no account is selected -->
                    <StackPanel x:Name="EmptyStatePanel" 
                                VerticalAlignment="Center" 
                                HorizontalAlignment="Center" 
                                Visibility="Collapsed">
                        <TextBlock x:Name="TxtNoAccountTitle" 
                                   Text="Chưa có tài khoản nào được chọn" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Foreground="#94a3b8" 
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtNoAccountGuide" 
                                   Text="Vui lòng bấm 'Thêm tài khoản mới' ở cột bên trái để bắt đầu." 
                                   FontSize="13" 
                                   Foreground="#64748b" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================================================== -->
        <!-- MODERN IN-APP MODAL: CREATE PROFILE, GROUPING & COLOR TAGGING  -->
        <!-- ============================================================== -->
        <Grid x:Name="CreateProfileOverlay" 
              Visibility="Collapsed" 
              Background="#80000000" 
              Panel.ZIndex="9999"
              MouseDown="CreateProfileOverlay_MouseDown">
            
            <Border Width="600" 
                    Background="#1e293b" 
                    BorderBrush="#334155" 
                    BorderThickness="1.5" 
                    CornerRadius="12" 
                    Padding="26" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    MouseDown="ModalCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#4f46e5" Margin="0,0,12,0">
                            <TextBlock Text="💬" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtModalTitle" 
                                       Text="Tạo Profile Chat Mới" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="#f8fafc"/>
                            <TextBlock x:Name="TxtModalSubtitle" 
                                       Text="Chọn nền tảng, phân nhóm và gán màu nhận diện để quản lý khoa học." 
                                       FontSize="11.5" 
                                       Foreground="#94a3b8"/>
                        </StackPanel>

                        <Button Grid.Column="2" 
                                Content="✕" 
                                Background="Transparent" 
                                Foreground="#94a3b8" 
                                BorderThickness="0" 
                                FontSize="14" 
                                Cursor="Hand" 
                                Click="BtnCloseModal_Click"/>
                    </Grid>

                    <Separator Background="#334155" Margin="0,0,0,14"/>

                    <!-- Section 1: Choose Platform (Grid of 10 chips) -->
                    <TextBlock x:Name="TxtSectionPlatform" 
                               Text="1. Chọn nền tảng chat:" 
                               FontSize="12" 
                               FontWeight="SemiBold" 
                               Foreground="#e2e8f0" 
                               Margin="0,0,0,6"/>
                    
                    <WrapPanel Margin="0,0,0,10">
                        <RadioButton x:Name="OptTeams" Style="{StaticResource PlatformChipStyle}" Content="🟣 Teams" IsChecked="True" Tag="Teams" Click="PlatformChip_Click"/>
                        <RadioButton x:Name="OptZalo" Style="{StaticResource PlatformChipStyle}" Content="🟦 Zalo" Tag="Zalo" Click="PlatformChip_Click"/>
                        <RadioButton x:Name="OptTelegram" Style="{StaticResource PlatformChipStyle}" Content="🔷 Telegram" Tag="Telegram" Click="PlatformChip_Click"/>
                        <RadioButton x:Name="OptMessenger" Style="{StaticResource PlatformChipStyle}" Content="🔵 Messenger" Tag="Messenger" Click="PlatformChip_Click"/>
                        <RadioButton x:Name="OptWhatsApp" Style="{StaticResource PlatformChipStyle}" Content="🟢 WhatsApp" Tag="WhatsApp" Click="PlatformChip_Click"/>
                        <RadioButton x:Name="OptDiscord" Style="{StaticResource PlatformChipStyle}" Content="🟣 Discord" Tag="Discord" Click="PlatformChip_Click"/>
                        <RadioButton x:Name="OptSlack" Style="{StaticResource PlatformChipStyle}" Content="🟡 Slack" Tag="Slack" Click="PlatformChip_Click"/>
                        <RadioButton x:Name="OptSkype" Style="{StaticResource PlatformChipStyle}" Content="🔵 Skype" Tag="Skype" Click="PlatformChip_Click"/>
                        <RadioButton x:Name="OptGoogleChat" Style="{StaticResource PlatformChipStyle}" Content="🟢 Google Chat" Tag="GoogleChat" Click="PlatformChip_Click"/>
                        <RadioButton x:Name="OptCustom" Style="{StaticResource PlatformChipStyle}" Content="🌐 Custom URL" Tag="Custom" Click="PlatformChip_Click"/>
                    </WrapPanel>

                    <!-- Section: Custom URL (Only visible when Custom is checked) -->
                    <StackPanel x:Name="ModalCustomUrlPanel" Visibility="Collapsed" Margin="0,0,0,10">
                        <TextBlock x:Name="TxtModalCustomUrlLabel" 
                                   Text="Địa chỉ URL (https://...):" 
                                   FontSize="11" 
                                   Foreground="#94a3b8" 
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtModalCustomUrl" 
                                 Background="#0f172a" 
                                 Foreground="#f8fafc" 
                                 BorderBrush="#334155" 
                                 Padding="8,6" 
                                 FontSize="12" 
                                 CaretBrush="#f8fafc"/>
                    </StackPanel>

                    <!-- Section 2: Account Name -->
                    <TextBlock x:Name="TxtSectionName" 
                               Text="2. Tên gợi nhớ tài khoản:" 
                               FontSize="12" 
                               FontWeight="SemiBold" 
                               Foreground="#e2e8f0" 
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtModalAccountName" 
                             Background="#0f172a" 
                             Foreground="#f8fafc" 
                             BorderBrush="#334155" 
                             BorderThickness="1" 
                             Padding="8,6" 
                             FontSize="13" 
                             CaretBrush="#f8fafc" 
                             KeyDown="TxtModalAccountName_KeyDown"
                             Margin="0,0,0,12"/>

                    <!-- Section 3: Group Selection with Preset Suggestions -->
                    <TextBlock x:Name="TxtSectionGroup" 
                               Text="3. Phân nhóm / Workspace:" 
                               FontSize="12" 
                               FontWeight="SemiBold" 
                               Foreground="#e2e8f0" 
                               Margin="0,0,0,4"/>
                    
                    <StackPanel Margin="0,0,0,12">
                        <TextBox x:Name="TxtModalGroupName" 
                                 Background="#0f172a" 
                                 Foreground="#f8fafc" 
                                 BorderBrush="#334155" 
                                 Padding="8,6" 
                                 FontSize="12" 
                                 CaretBrush="#f8fafc" 
                                 Margin="0,0,0,6"/>
                        <!-- Quick Group Preset Chips -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Gợi ý: " FontSize="11" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource GroupSuggestionChipStyle}" Content="🏢 Công việc" Click="GroupSuggestion_Click" Tag="🏢 Công việc"/>
                            <Button Style="{StaticResource GroupSuggestionChipStyle}" Content="🛒 Bán hàng" Click="GroupSuggestion_Click" Tag="🛒 Bán hàng"/>
                            <Button Style="{StaticResource GroupSuggestionChipStyle}" Content="👥 Cá nhân" Click="GroupSuggestion_Click" Tag="👥 Cá nhân"/>
                            <Button Style="{StaticResource GroupSuggestionChipStyle}" Content="⭐ VIP" Click="GroupSuggestion_Click" Tag="⭐ VIP"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Section 4: Color Tag Palette -->
                    <TextBlock x:Name="TxtSectionColor" 
                               Text="4. Đánh dấu màu nhận diện (Tag Color):" 
                               FontSize="12" 
                               FontWeight="SemiBold" 
                               Foreground="#e2e8f0" 
                               Margin="0,0,0,6"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Border x:Name="SwatchRed" Width="28" Height="28" CornerRadius="14" Background="#ef4444" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0" BorderBrush="White" ToolTip="Đỏ (Khẩn cấp / VIP)" MouseLeftButtonDown="Swatch_MouseLeftButtonDown" Tag="#ef4444"/>
                        <Border x:Name="SwatchOrange" Width="28" Height="28" CornerRadius="14" Background="#f97316" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0" BorderBrush="White" ToolTip="Cam (Bán hàng / Leads)" MouseLeftButtonDown="Swatch_MouseLeftButtonDown" Tag="#f97316"/>
                        <Border x:Name="SwatchYellow" Width="28" Height="28" CornerRadius="14" Background="#eab308" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0" BorderBrush="White" ToolTip="Vàng (Chăm sóc KH)" MouseLeftButtonDown="Swatch_MouseLeftButtonDown" Tag="#eab308"/>
                        <Border x:Name="SwatchGreen" Width="28" Height="28" CornerRadius="14" Background="#10b981" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0" BorderBrush="White" ToolTip="Xanh lục (Đã chốt)" MouseLeftButtonDown="Swatch_MouseLeftButtonDown" Tag="#10b981"/>
                        <Border x:Name="SwatchBlue" Width="28" Height="28" CornerRadius="14" Background="#3b82f6" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0" BorderBrush="White" ToolTip="Xanh dương (Khách lẻ)" MouseLeftButtonDown="Swatch_MouseLeftButtonDown" Tag="#3b82f6"/>
                        <Border x:Name="SwatchPurple" Width="28" Height="28" CornerRadius="14" Background="#8b5cf6" Margin="0,0,8,0" Cursor="Hand" BorderThickness="2" BorderBrush="White" ToolTip="Tím (Nội bộ Cty)" MouseLeftButtonDown="Swatch_MouseLeftButtonDown" Tag="#8b5cf6"/>
                        <Border x:Name="SwatchPink" Width="28" Height="28" CornerRadius="14" Background="#ec4899" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0" BorderBrush="White" ToolTip="Hồng (Cá nhân)" MouseLeftButtonDown="Swatch_MouseLeftButtonDown" Tag="#ec4899"/>
                        <Border x:Name="SwatchSlate" Width="28" Height="28" CornerRadius="14" Background="#64748b" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0" BorderBrush="White" ToolTip="Xám (Mặc định)" MouseLeftButtonDown="Swatch_MouseLeftButtonDown" Tag="#64748b"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                x:Name="BtnModalCancel"
                                Content="Hủy" 
                                Background="#334155" 
                                Foreground="#cbd5e1" 
                                FontSize="13" 
                                FontWeight="SemiBold" 
                                Padding="18,9" 
                                Cursor="Hand" 
                                BorderThickness="0" 
                                Click="BtnCloseModal_Click"/>

                        <Button Grid.Column="2" 
                                x:Name="BtnModalSubmit"
                                Content="Tạo Profile" 
                                Background="#4f46e5" 
                                Foreground="White" 
                                FontSize="13" 
                                FontWeight="Bold" 
                                Padding="26,9" 
                                Cursor="Hand" 
                                BorderThickness="0" 
                                Click="BtnModalSubmit_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
